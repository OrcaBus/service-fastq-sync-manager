{
  "Comment": "Initialise task token for a Fastq Set ID",
  "StartAt": "Save input vars",
  "States": {
    "Save input vars": {
      "Type": "Pass",
      "Next": "Check fastq set id against requirements",
      "Assign": {
        "taskToken": "{% $states.input.taskToken %}",
        "fastqSetId": "{% $states.input.payload.fastqSet %}",
        "requirements": "{% $states.input.payload.requirements %}",
        "waitForBam": "{% $states.input.payload.waitForBam ? true : false %}",
        "callbackId": "{% $states.input.callbackId %}",
        "dynamoDbTableName": "${__dynamodb_table_name__}",
        "dynamoDbIdTypeKeys": {
          "fastqSetId": "FASTQ_SET_ID",
          "taskToken": "TASK_TOKEN"
        }
      }
    },
    "Check fastq set id against requirements": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__check_fastq_set_id_against_requirements_lambda_function_arn__}",
        "Payload": {
          "fastqSetId": "{% $fastqSetId %}",
          "requirements": "{% $requirements %}",
          "waitForBam": "{% $waitForBam %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Assign": {
        "requirementsList": "{% $keys($sift($requirements, function($v){$v})) %}"
      },
      "Output": {
        "hasAllRequirements": "{% $states.result.Payload.hasAllRequirements %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Send Immediate Task Failure",
          "Output": {
            "error": "{% $states.errorOutput %}"
          }
        }
      ],
      "Next": "Meets requirements"
    },
    "Send Immediate Task Failure": {
      "Type": "Task",
      "Arguments": {
        "TaskToken": "{% $taskToken %}",
        "Error": "{% $parse($states.input.error.Cause).errorType ? $parse($states.input.error.Cause).errorType : 'FastqSetCheckError' %}",
        "Cause": "{% $parse($states.input.error.Cause).errorMessage %}"
      },
      "Resource": "arn:aws:states:::aws-sdk:sfn:sendTaskFailure",
      "Next": "Unlock callback id"
    },
    "Unlock callback id": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${__unlock_callback_id_lambda_function_arn__}",
        "Payload": {
          "callbackId": "{% $callbackId %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "End": true
    },
    "Meets requirements": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Send Immediate Task Success",
          "Condition": "{% $states.input.hasAllRequirements %}",
          "Comment": "Fastq Set Id already satisfies all requirements"
        }
      ],
      "Default": "Register Task Token in Database"
    },
    "Register Task Token in Database": {
      "Type": "Parallel",
      "Next": "Launch Fastq Set Requirements",
      "Branches": [
        {
          "StartAt": "Register Fastq Sync Event (token)",
          "States": {
            "Register Fastq Sync Event (token)": {
              "Type": "Task",
              "Resource": "arn:aws:states:::dynamodb:putItem",
              "Arguments": {
                "TableName": "{% $dynamoDbTableName %}",
                "Item": {
                  "id": {
                    "S": "{% $taskToken %}"
                  },
                  "id_type": {
                    "S": "{% $dynamoDbIdTypeKeys.taskToken %}"
                  },
                  "fastq_id_set": {
                    "SS": "{% [$fastqSetId] %}"
                  },
                  "requirements_set": {
                    "SS": "{% [$keys($sift($requirements, function($v){$v}))] %}"
                  },
                  "wait_for_bam": {
                    "BOOL": "{% $waitForBam %}"
                  },
                  "expiresAt": {
                    "N": "{% ($round($toMillis($now()) / 1000) + (60 * 60 * 24 * 7)) ~> $string %}"
                  }
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "Get fastq set id in db",
          "States": {
            "Get fastq set id in db": {
              "Type": "Task",
              "Resource": "arn:aws:states:::dynamodb:getItem",
              "Arguments": {
                "TableName": "{% $dynamoDbTableName %}",
                "Key": {
                  "id": {
                    "S": "{% $fastqSetId %}"
                  },
                  "id_type": {
                    "S": "{% $dynamoDbIdTypeKeys.fastqSetId %}"
                  }
                }
              },
              "Next": "Fastq Set ID in Sync DB"
            },
            "Fastq Set ID in Sync DB": {
              "Type": "Choice",
              "Choices": [
                {
                  "Next": "Add task token to fastq set id",
                  "Condition": "{% $states.input.Item ? true : false %}",
                  "Comment": "Fastq Set ID already in db"
                }
              ],
              "Default": "Register Fastq Sync Event (fastq set id)"
            },
            "Add task token to fastq set id": {
              "Type": "Task",
              "Resource": "arn:aws:states:::dynamodb:updateItem",
              "Arguments": {
                "TableName": "{% $dynamoDbTableName %}",
                "Key": {
                  "id": {
                    "S": "{% $fastqSetId %}"
                  },
                  "id_type": {
                    "S": "{% $dynamoDbIdTypeKeys.fastqSetId %}"
                  }
                },
                "UpdateExpression": "ADD task_token_set :task_token",
                "ExpressionAttributeValues": {
                  ":task_token": {
                    "SS": "{% [$taskToken] %}"
                  }
                }
              },
              "End": true
            },
            "Register Fastq Sync Event (fastq set id)": {
              "Type": "Task",
              "Resource": "arn:aws:states:::dynamodb:putItem",
              "Arguments": {
                "TableName": "{% $dynamoDbTableName %}",
                "Item": {
                  "id": {
                    "S": "{% $fastqSetId %}"
                  },
                  "id_type": {
                    "S": "{% $dynamoDbIdTypeKeys.fastqSetId %}"
                  },
                  "task_token_set": {
                    "SS": "{% [$taskToken] %}"
                  },
                  "expiresAt": {
                    "N": "{% ($round($toMillis($now()) / 1000) + (60 * 60 * 24 * 7)) ~> $string %}"
                  }
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "Enable External Heartbeat monitoring",
          "States": {
            "Enable External Heartbeat monitoring": {
              "Type": "Task",
              "Arguments": {
                "Name": "${__heartbeat_scheduler_rule_name__}"
              },
              "Resource": "arn:aws:states:::aws-sdk:eventbridge:enableRule",
              "End": true,
              "Retry": [
                {
                  "ErrorEquals": ["EventBridge.InternalException"],
                  "BackoffRate": 2,
                  "IntervalSeconds": 1,
                  "MaxAttempts": 3
                }
              ]
            }
          }
        }
      ]
    },
    "Send Immediate Task Success": {
      "Type": "Task",
      "Arguments": {
        "Output": {},
        "TaskToken": "{% $taskToken %}"
      },
      "Resource": "arn:aws:states:::aws-sdk:sfn:sendTaskSuccess",
      "Next": "Unlock callback id"
    },
    "Launch Fastq Set Requirements": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Arguments": {
        "StateMachineArn": "${__launch_fastq_set_requirements_sfn_arn__}",
        "Input": {
          "fastqSetId": "{% $fastqSetId %}",
          "requirements": "{% $requirementsList %}",
          "waitForBam": "{% $waitForBam %}"
        }
      },
      "Next": "Unlock callback id"
    }
  },
  "QueryLanguage": "JSONata"
}
